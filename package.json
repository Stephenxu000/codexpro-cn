{
  "name": "codexpro",
  "version": "0.30.0",
  "private": true,
  "description": "Local MCP server that connects ChatGPT Plugins to explicitly allowed repos on your machine.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stephenxu000/codexpro-cn.git"
  },
  "bugs": {
    "url": "https://github.com/Stephenxu000/codexpro-cn/issues"
  },
  "homepage": "https://github.com/Stephenxu000/codexpro-cn#readme",
  "contributors": [
    {
      "name": "yuczzzzz",
      "url": "https://github.com/yuczzzzz"
    }
  ],
  "keywords": [
    "mcp",
    "chatgpt",
    "codex",
    "apps-sdk",
    "codexpro",
    "local-development",
    "cloudflare-tunnel",
    "ngrok",
    "tailscale"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "docs/index.html",
    "docs/zh.html",
    "docs/styles.css",
    "docs/script.js",
    "docs/favicon.svg",
    "docs/og.svg",
    "docs/star.svg",
    "docs/images",
    "scripts",
    "README.md",
    "README_ZH.md",
    "PUBLIC_LAUNCH_CHECKLIST.md",
    "DOMAIN_SETUP.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CONTRIBUTORS.md",
    "FAQ.md",
    "FAQ_ZH.md",
    "CHANGELOG.md",
    "CHATGPT_PROMPT.md",
    "CODEX_PROMPT.md",
    "AGENTS.example.md",
    "config.example.env"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "codexpro": "scripts/codexpro.mjs",
    "codexpro-mcp": "dist/stdio.js",
    "codexpro-mcp-http": "dist/http.js"
  },
  "scripts": {
    "test": "npm run build && node scripts/external-brain-smoke.mjs && node scripts/adr-bash-classification-smoke.mjs && node scripts/adr-host-smoke.mjs && node scripts/adr-host-server-smoke.mjs && node scripts/smoke.mjs",
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "prepublishOnly": "node scripts/release-guard.mjs",
    "start": "node dist/stdio.js",
    "start:stdio": "node dist/stdio.js",
    "start:http": "node dist/http.js",
    "dev:stdio": "tsx src/stdio.ts",
    "dev:http": "tsx src/http.ts",
    "smoke": "node scripts/analysis-smoke.mjs && node scripts/analysis-cli-smoke.mjs && node scripts/smoke.mjs && node scripts/skill-precedence-smoke.mjs && node scripts/import-smoke.mjs && node scripts/http-smoke.mjs && node scripts/stateless-http-smoke.mjs && node scripts/tool-surface-smoke.mjs && node scripts/git-tools-smoke.mjs && node scripts/widget-smoke.mjs && node scripts/pro-smoke.mjs && node scripts/doctor-smoke.mjs && node scripts/settings-smoke.mjs && node scripts/execute-handoff-smoke.mjs && node scripts/release-guard-smoke.mjs",
    "stress": "npm run build && node scripts/stress.mjs",
    "analysis:smoke": "npm run build && node scripts/analysis-smoke.mjs",
    "analysis:cli-smoke": "npm run build && node scripts/analysis-cli-smoke.mjs",
    "doctor": "node scripts/codexpro.mjs doctor",
    "connect": "node scripts/codexpro.mjs",
    "connect:setup": "node scripts/codexpro.mjs setup",
    "connect:local": "node scripts/codexpro.mjs --tunnel none",
    "connect:cloudflare": "node scripts/codexpro.mjs --tunnel cloudflare",
    "connect:chatgpt": "node scripts/codexpro.mjs --tunnel cloudflare",
    "connect:stable": "node scripts/codexpro.mjs --tunnel cloudflare-named",
    "connect:ngrok": "node scripts/codexpro.mjs ngrok",
    "connect:tailscale": "node scripts/codexpro.mjs tailscale",
    "pro:bundle": "node scripts/pro-bundle.mjs",
    "pro:apply": "node scripts/pro-apply.mjs",
    "release:guard": "node scripts/release-guard.mjs",
    "release:pack": "node scripts/release-pack.mjs",
    "release:check": "npm run release:guard && npm run build && npm run smoke && npm run stress && npm audit --audit-level=high && npm run release:pack",
    "release:publish": "node scripts/release-publish.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "minimatch": "^10.0.1",
    "zod": "^4.2.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
